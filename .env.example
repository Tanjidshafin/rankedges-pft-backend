## MetaApi sync — Firestore write tuning (RESOURCE_EXHAUSTED mitigation)

# Minimum interval between Firestore sync-progress writes per document. Same-phase repeats within window are skipped.
SYNC_PROGRESS_MIN_INTERVAL_MS=2500

# BulkWriter throughput for metaApiTrades/metaApiPositions (writes/sec; minimum 10 in code).
FIRESTORE_MAX_WRITES_PER_SEC=200

## Trade persistence modes
# Cron + scheduled sync-all paths. Does NOT apply to admin single-account sync (always full) or POST /sync-account unless user_ui mode below says otherwise.
METAAPI_SYNC_TRADES_MODE=full

# Admin "Sync All" only. Empty → metrics_only. full | metrics_only
METAAPI_SYNC_ALL_TRADES_MODE=

# Owner app POST /api/meta-api/sync-account (connect + user-triggered backend sync).
# Empty or unset → metrics_only (recommended on Spark — avoids firing thousands of trade writes during connect).
# full → persist full trade history on that sync when you accept higher Firestore usage.
METAAPI_SYNC_USER_UI_TRADES_MODE=
